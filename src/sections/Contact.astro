
<section id="contact" class="bento-card md:col-span-3 lg:col-span-4">
    <h2 class="text-xl font-black uppercase bg-red-600 text-white dark:bg-white dark:text-black p-2 mb-5 inline-block">
        Contact Me
    </h2>

    <p class="font-bold text-sm uppercase mb-5 text-slate-800 dark:text-slate-200">
        Have a project or collaboration in mind? Feel free to contact me!
    </p>

    <form class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <input
            type="text"
            placeholder="YOUR NAME"
            required
            class="border-4 border-black dark:border-white p-3 font-bold text-xs bg-slate-50 dark:bg-slate-800 text-black dark:text-white uppercase"
        />

        <input
            type="email"
            placeholder="YOUR EMAIL"
            required
            class="border-4 border-black dark:border-white p-3 font-bold text-xs bg-slate-50 dark:bg-slate-800 text-black dark:text-white uppercase"
        />

        <textarea
            rows="4"
            placeholder="YOUR MESSAGE..."
            required
            class="md:col-span-2 border-4 border-black dark:border-white p-3 font-bold text-xs bg-slate-50 dark:bg-slate-800 text-black dark:text-white uppercase"
        ></textarea>

        <button type="submit" class="btn-accent md:col-span-2 w-full text-xs">
            Send Message
        </button>
    </form>
</section>

